<!DOCTYPE html>
<html>
  <head>
    <title>宿泊予約アプリ</title>
      <meta name="viewport" content="width=device-width,initial-scale=1">
      <%= csrf_meta_tags %>
      <%= csp_meta_tag %>
      <!--以下にbootstrapを記述-->
      <%= stylesheet_link_tag 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css', integrity: 'sha384-KyZXEAg3QhqLMpG8r+8fhAXLRb2ldM4e4xd4Ny5lrZDJmTfFFGFGc2y7z8b5jwHl', crossorigin: 'anonymous' %>
      <%= javascript_include_tag 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js', integrity: 'sha384-YpS0Z0DlGJr58n29OQNlYm5uScFq08RT+l+W1aE5XiwBGf+mvKRAgOm7CIQgRxEV', crossorigin: 'anonymous' %>
      <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
      <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    </head>

  <!--body全体をフレックスボックスに指定-->
  <body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="http://localhost:3000/">
      <img src="/assets/logo.png" alt="Logo" class="d-inline-block align-text-top" style="height: 40px; width: auto;">
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <!-- プロフィール画像を表示 -->
              <% if current_user.icon.attached? %>
                <%= image_tag current_user.icon, alt: current_user.name, class: "profile-image me-2"%>
              <% else %>
                <%= image_tag "default-avatar-7a6cbfd7993e89f24bfc888f4a035a83c6f1428b8bdc47eed9095f2799a40153.png", alt: "デフォルトプロフィール画像", class: "profile-image me-2" %>
              <% end %>
              <%= current_user.name || "ユーザー" %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <li><%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %></li>
              <li><%= link_to "予約済み一覧", reservations_path, class: "dropdown-item" %></li>
              <li><%= link_to "登録済み一覧", my_rooms_rooms_path, class: "dropdown-item" %></li>
              <li><%= link_to "アカウント設定", edit_user_registration_path, class: "dropdown-item" %></li>
              <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "ログイン", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "新規登録", new_user_registration_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

  <!-- メインコンテンツ -->
  <main class="flex-grow-1">
  <%= yield %>
  </main>
  <!-- フッター -->
  <%= render 'layouts/footer' %>
  </body>
</html>
