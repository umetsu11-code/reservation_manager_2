<header class="text-center mt-5">
  <h2 class="fw-bold">新規登録</h2>
</header>
<body>
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'needs-validation' }) do |f| %>
              <%= render "devise/shared/error_messages", resource: resource %>

              <!-- ユーザー名 -->
              <div class="mb-3">
                <%= f.label :name, "ユーザー名", class: "form-label" %>
                <%= f.text_field :name, class: "form-control", placeholder: "ユーザー名を入力" %>
              </div>

              <!-- メールアドレス -->
              <div class="mb-3">
                <%= f.label :email, "メールアドレス", class: "form-label" %>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "example@example.com" %>
              </div>

              <!-- パスワード -->
              <div class="mb-3">
                <%= f.label :password, "パスワード", class: "form-label" %>
                <% if @minimum_password_length %>
                  <small class="form-text text-muted">パスワードは<%= @minimum_password_length %>文字以上必要です。</small>
                <% end %>
                <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "••••••••" %>
              </div>

              <!-- 確認用パスワード -->
              <div class="mb-3">
                <%= f.label :password_confirmation, "確認用パスワード", class: "form-label" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "••••••••" %>
              </div>

              <!-- 新規登録ボタン -->
              <div class="d-grid">
                <%= f.submit "新しいアカウントを作成", class: "btn btn-primary btn-block" %>
              </div>
            <% end %>

            <!-- リンク -->
            <div class="mt-3 text-center">
              <%= render "devise/shared/links" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
