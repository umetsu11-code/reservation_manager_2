<div class="container my-4">
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="card-title text-center mb-4">施設登録フォーム</h2>

      <!-- フォーム -->
      <%= form_with model: @room, local: true, html: { class: "needs-validation" } do |f| %>
        <!-- エラーメッセージ -->
        <% if @room.errors.any? %>
          <div class="alert alert-danger">
            <h4>以下のエラーを修正してください:</h4>
            <ul>
              <% @room.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- フォームフィールド -->
        <div class="mb-3">
          <%= f.label :name, "施設名", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", placeholder: "施設名を入力してください", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :description, "施設詳細", class: "form-label" %>
          <%= f.text_area :description, class: "form-control", placeholder: "施設の詳細を入力してください", rows: 5, required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :price, "宿泊料金", class: "form-label" %>
          <%= f.number_field :price, class: "form-control", placeholder: "例: 10000", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :address, "住所", class: "form-label" %>
          <%= f.text_field :address, class: "form-control", placeholder: "住所を入力してください", required: true %>
        </div>

        <div class="mb-3">
          <%= f.label :image, "施設画像", class: "form-label" %>
          <%= f.file_field :image, class: "form-control" %>
        </div>

        <!-- 登録ボタン -->
        <div class="text-center">
          <%= f.submit "登録", class: "btn btn-primary w-100 py-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
