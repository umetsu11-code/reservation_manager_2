<div class="container my-4">
  <!-- 検索フォーム -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <h4 class="card-title">施設を検索</h4>
      <%= search_form_for @q, url: rooms_path, method: :get, html: { class: "needs-validation" } do |f| %>
        <div class="mb-3">
          <%= f.label :address_cont, "エリア名を入力", class: "form-label" %>
          <%= f.text_field :address_cont, class: "form-control", placeholder: "例: 東京、大阪" %>
        </div>
        <div class="mb-3">
          <%= f.label :name_or_description_cont, "キーワード名を入力", class: "form-label" %>
          <%= f.text_field :name_or_description_cont, class: "form-control", placeholder: "例: ビーチ、リゾート" %>
        </div>
        <div class="d-flex justify-content-end">
          <%= f.submit "検索", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 検索結果表示 -->
  <p class="text-muted"><%= @total_rooms %>件が見つかりました。</p>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @rooms.each do |room| %>
      <div class="col">
        <div class="card h-100 shadow-sm">
          <!-- デフォルト画像対応 -->
          <% if room.image_url.present? %>
            <img src="<%= room.image_url %>" alt="<%= room.name %>" class="card-img-top img-fluid">
          <% else %>
            <%= image_tag 'default-image-4e0ac6b8d01335b5b22fe6586af13644ae51dddb6aeabf35b9174e80f13cd09d', alt: room.name, class: "card-img-top img-fluid" %>
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= link_to room.name, room_path(room), class: "text-decoration-none" %></h5>
            <p class="card-text"><%= room.description %></p>
            <p class="card-text"><strong>料金:</strong> <%= room.price %>円/日</p>
            <p class="card-text"><strong>住所:</strong> <%= room.address %></p>
            <p class="card-text"><small class="text-muted">作成日: <%= room.created_at.strftime("%Y-%m-%d") %></small></p>
          </div>
          <div class="card-footer text-end">
            <%= link_to "詳細はこちら", room_path(room), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

