<body>
<div class="FirstView">
 <section class="container">
 <h3 class="FirstView__title">Potepan Shareで<br>
 まだ体験したことのない<br>
 旅をしよう</h3>
 <!-- 検索フォーム -->
 <div class="FirstViewSearch">
  <%= search_form_for @q, url: rooms_path, method: :get do |f| %>
    <div>
    <%= f.text_field :name_or_description_or_address_cont, 
    placeholder: "エリア名を入力", 
    class: "form-control" %>
    </div>
    <%= f.submit "検索", class: "btn btn-primary mt-2" %>
  <% end %>
 </div>
<section class="RecommendAreaSection">
  <h2 class="RecommendAreaSection__title text-center mb-4">おすすめのエリア</h2>
  <div class="RecommendAreas d-flex flex-wrap justify-content-center gap-3">
    <%= link_to rooms_path(area: "東京"), class: "btn btn-primary px-0 py-0 btn-with-image" do %>
      <img src="<%= asset_path('tokyo.jpeg') %>" alt="東京" class="btn-image">
      <span>東京</span>
    <% end %>

    <%= link_to rooms_path(area: "大阪"), class: "btn btn-primary px-0 py-0 btn-with-image" do %>
      <img src="<%= asset_path('osaka.jpeg') %>" alt="大阪" class="btn-image">
      <span>大阪</span>
    <% end %>

    <%= link_to rooms_path(area: "京都"), class: "btn btn-primary px-0 py-0 btn-with-image" do %>
      <img src="<%= asset_path('kyoto.jpeg') %>" alt="京都" class="btn-image">
      <span>京都</span>
    <% end %>

    <%= link_to rooms_path(area: "札幌"), class: "btn btn-primary px-0 py-0 btn-with-image" do %>
      <img src="<%= asset_path('sapporo.jpeg') %>" alt="札幌" class="btn-image">
      <span>札幌</span>
    <% end %>
  </div>
</section>

</div>
</body>
