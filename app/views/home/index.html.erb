<body>
<div class="FirstView">
 <section class="container">
 <h3 class="FirstView__title">Potepan Shareで<br>
 まだ体験したことのない<br>
 旅をしよう</h3>
 <!-- 検索フォーム それ自体のcss修正はbootstrapから持ってくる-->
 <div class="FirstViewSearch">
  <%= search_form_for @q, url: rooms_path, method: :get do |f| %>
    <div>
      <%= f.text_field :address_cont, placeholder: "エリア名を入力", class: "form-control" %>
    </div>
    <%= f.submit "検索", class: "btn btn-primary mt-2" %>
  <% end %>
 </div>
 </section>
  <!-- 結果表示エリア 検索結果を表示させる際に画面遷移を伴うように のち修正-->
  <div class="container">
  <section class="RecommendAreaSection">
  <h2 class="RecommendAreaSection__title">おすすめのエリア</h2>
  <div class="RecommendAreas d-flex flex-wrap justify-content-center gap-3">
    <%= link_to "東京", rooms_path(area: "東京"), class: "btn btn-primary px-4 py-2" %>
    <%= link_to "大阪", rooms_path(area: "大阪"), class: "btn btn-primary px-4 py-2" %>
    <%= link_to "京都", rooms_path(area: "京都"), class: "btn btn-primary px-4 py-2" %>
    <%= link_to "札幌", rooms_path(area: "札幌"), class: "btn btn-primary px-4 py-2" %>
  </div>
</section>
</div>
</body>
