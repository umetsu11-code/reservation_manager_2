
<div class="container mt-4">
  <div class="card shadow-sm">
    <div class="card-header">
      <h1 class="card-title mb-0">予約確認</h1>
    </div>
    <div class="card-body">
      <p class="card-text"><strong>チェックイン:</strong> <%= @reservation.check_in_date %></p>
      <p class="card-text"><strong>チェックアウト:</strong> <%= @reservation.check_out_date %></p>
      <p class="card-text"><strong>宿泊日数:</strong> <%= @reservation.total_days %>日</p>
      <p class="card-text"><strong>人数:</strong> <%= @reservation.number_of_guests %>人</p>
      <p class="card-text"><strong>合計料金:</strong> <%= @reservation.total_price %>円</p>
    </div>
    <div class="card-footer d-flex justify-content-between">
      <% if !@reservation.confirmed? %>
        <%= button_to "予約を確定", confirm_reservation_path(@reservation), method: :patch, class: "btn btn-primary" %>
      <% end %>
      <%= link_to "戻る", request.referer || reservations_path, class: "btn btn-secondary" %>
  </div>
</div>
